# =================================================================
# 📱 TELEGRAM API CREDENTIALS (https://my.telegram.org/apps)
# =================================================================
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
PHONE_NUMBER=YOUR_PHONE_NUMBER_WITH_COUNTRY_CODE

# =================================================================
# 🧠 GEMINI (comma-separated keys = round-robin + failover)
# =================================================================
GEMINI_API_KEYS=YOUR_GEMINI_KEY

# Single-model mode (used when GEMINI_MODELS below is empty)
MODEL_NAME=gemini-3.5-flash-lite

# -----------------------------------------------------------------
# 🔁 MULTI-MODEL ROTATION (optional but recommended)
# Format:  model[:requests_per_minute[:requests_per_day]]
# Each model keeps its OWN budget. When a model runs out of quota or
# Google answers 429/404, the engine moves to the next model instead
# of dropping your message. Order matters: cheapest/fastest first.
# -----------------------------------------------------------------
GEMINI_MODELS="gemini-3.5-flash-lite:15:1000,gemini-2.5-flash:10:250,gemini-2.0-flash:15:200"
# Fallbacks applied when a line omits its quotas
DEFAULT_MODEL_RPM=15
DEFAULT_MODEL_RPD=200
# Grounded web-search calls need a search-capable model (not *-flash-lite)
SEARCH_MODEL_NAME=gemini-2.5-flash

# =================================================================
# 👤 IDENTITY
# =================================================================
# Telegram numeric user id of the owner (the account the bot runs on)
OWNER_ID=YOUR_TELEGRAM_USER_ID
# Display name the bot answers as (used in group mention detection & prompts)
PERSONA_NAME=شایان

# -----------------------------------------------------------------
# 🧬 OWNER PROFILE — woven into Pal & Assistant prompts
# Keep it short and spoken, exactly like you would describe yourself
# to a stranger in a chat. Leave a line empty to skip it.
# -----------------------------------------------------------------
OWNER_NAME=پرهام
OWNER_BIO=دانشجو و برنامه‌نویسم، بیشتر وقتم پای پروژه‌های پایتون و بات‌های تلگرامی می‌گذرد.
OWNER_SERVICES=ساخت بات تلگرام، اسکریپت‌های پایتون و راه‌اندازی سرور
OWNER_INTERESTS=موسیقی، فیلم، تکنولوژی و شب‌نشینی‌های طولانی پای کد
OWNER_SCHEDULE=بیشتر شب‌ها آنلاینم؛ روزها دیر جواب می‌دهم
OWNER_WEBSITE=
OWNER_EXTRA=کوتاه و خودمونی حرف می‌زنم و اهل تعارف زیاد نیستم.
# Set to 0 to keep prompts exactly as they were (no profile injection)
OWNER_PROFILE_IN_PROMPTS=1

# =================================================================
# ☁️ RAILWAY / CLOUD DEPLOYMENT (recommended)
# =================================================================
# Generate ONCE with:  python3 gen_session_string.py
SESSION_STRING=
SESSION_NAME=teleagent_session

# Persistent storage: Railway volume mount point (state files survive restarts)
DATA_DIR=/app/data

# =================================================================
# ⚙️ TUNING (optional — defaults are fine)
# =================================================================
# Gemini hard timeout per attempt in seconds; web-search uses SEARCH_TIMEOUT
GEMINI_TIMEOUT=15
SEARCH_TIMEOUT=45
# Stealth confirmations to Saved Messages (1=on), auto-delete after N seconds
STEALTH_CONFIRM=1
CONFIRM_AUTO_DELETE_SECONDS=10
# Push engine errors to Saved Messages instead of failing silently
NOTIFY_ERRORS=1

# =================================================================
# 🖥 VPS DEPLOY ONLY (deploy.sh) — not needed on Railway
# =================================================================
VPS_IP=YOUR_VPS_IP
SSH_USER=root
SSH_PORT=22
